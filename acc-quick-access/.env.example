# Copy this file to .env and fill in the values. Never commit .env.
APS_CLIENT_ID=
APS_CLIENT_SECRET=
# Must match the Callback URL in your APS app exactly.
# Local: http://localhost:3000/auth/callback
# Hosted: https://your-app.example.com/auth/callback
APS_CALLBACK_URL=http://localhost:3000/auth/callback
# Any long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=
PORT=3000
